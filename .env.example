SERVICE_CODE=EVENT_BOOKING
PUBLIC_BASE_URL=http://localhost:8501

# Optional: set this to the same outbound_api_key registered in Super App.
OUTBOUND_API_KEY=

# Optional: issued by Partner Portal after Mini App approval.
# Keep these backend-only. Do not expose them in public JS, OpenAPI, or docs.
SUPERAPP_APP_ID=
SUPERAPP_KEY_ID=
SUPERAPP_API_KEY=
SUPERAPP_ENVIRONMENT=sandbox
SUPERAPP_MINIAPP_ORIGIN=http://localhost:8501

# Optional: fill after Supabase credentials are available.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: webhook target if event status callbacks are added later.
SUPERAPP_WEBHOOK_URL=
